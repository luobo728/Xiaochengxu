/* custom-tab-bar/index.wxss —— 底部导航：白底 + 4 个 CSS 图标 + 中间凸起「+」
   图标统一用 currentColor 着色：未选中 #9AA1AD，选中 #2E6BFF */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(24, 40, 80, 0.06);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-inner {
  display: flex;
  align-items: center;
  height: 108rpx;
}

.tab-item {
  flex: 1;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 中间那一格现在整格可点（wxml 里绑定了 onScan），所以不再拦截点击 */

.tab-ico {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  color: #9AA1AD;
  transition: color 0.2s ease;
}

.tab-txt {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1;
  color: #9AA1AD;
  transition: color 0.2s ease;
}

.tab-item.on .tab-ico,
.tab-item.on .tab-txt {
  color: #2E6BFF;
}

.tab-item.on .tab-txt {
  font-weight: 600;
}

/* ---------- 图标 1：首页（房子轮廓 + 选中时屋内小横条） ---------- */
.ic-home .roof {
  position: absolute;
  left: 50%;
  top: 1rpx;
  margin-left: -23rpx;
  width: 0;
  height: 0;
  border-left: 23rpx solid transparent;
  border-right: 23rpx solid transparent;
  border-bottom: 22rpx solid currentColor;
}

.ic-home .body {
  position: absolute;
  left: 50%;
  bottom: 1rpx;
  margin-left: -19rpx;
  width: 38rpx;
  height: 26rpx;
  border: 6rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 10rpx 10rpx;
}

.ic-home .bar {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  margin-left: -11rpx;
  width: 22rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.tab-item.on .ic-home .bar {
  opacity: 1;
}

/* ---------- 图标 2：课时（时钟） ---------- */
.ic-clock .dial {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  border: 6rpx solid currentColor;
  border-radius: 50%;
}

.ic-clock .hand-h {
  position: absolute;
  left: 50%;
  top: 50%;
  margin-left: -3rpx;
  margin-top: -15rpx;
  width: 6rpx;
  height: 16rpx;
  border-radius: 3rpx;
  background: currentColor;
}

.ic-clock .hand-m {
  position: absolute;
  left: 50%;
  top: 50%;
  margin-top: -3rpx;
  width: 16rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
}

.ic-clock .hand-c {
  position: absolute;
  left: 50%;
  top: 50%;
  margin-left: -4rpx;
  margin-top: -4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

/* ---------- 图标 3：校园（教学楼） ---------- */
.ic-school .roof {
  position: absolute;
  left: 50%;
  top: 2rpx;
  margin-left: -23rpx;
  width: 0;
  height: 0;
  border-left: 23rpx solid transparent;
  border-right: 23rpx solid transparent;
  border-bottom: 18rpx solid currentColor;
}

.ic-school .wall {
  position: absolute;
  left: 50%;
  top: 18rpx;
  margin-left: -20rpx;
  width: 40rpx;
  height: 26rpx;
  border: 6rpx solid currentColor;
  border-radius: 3rpx 3rpx 8rpx 8rpx;
}

.ic-school .win {
  position: absolute;
  top: 27rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.ic-school .w1 {
  left: 17rpx;
}

.ic-school .w2 {
  left: 25rpx;
}

/* ---------- 图标 4：我的（头像 + 肩） ---------- */
.ic-me .head {
  position: absolute;
  left: 50%;
  top: 3rpx;
  margin-left: -10rpx;
  width: 20rpx;
  height: 20rpx;
  border: 5rpx solid currentColor;
  border-radius: 50%;
}

.ic-me .shoulder {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  margin-left: -18rpx;
  width: 36rpx;
  height: 20rpx;
  border: 5rpx solid currentColor;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
}

/* ---------- 中间凸起的「+」按钮 ---------- */
.tab-center {
  position: absolute;
  left: 50%;
  top: -44rpx;
  z-index: 3;
  margin-left: -62rpx;
  width: 124rpx;
  height: 124rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: linear-gradient(135deg, #59A2FF, #2E6BFF);
  box-shadow: 0 14rpx 28rpx rgba(46, 107, 255, 0.38);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.tab-center-hover {
  transform: scale(0.94);
  box-shadow: 0 8rpx 18rpx rgba(46, 107, 255, 0.3);
}

.plus {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.plus::before,
.plus::after {
  content: '';
  position: absolute;
  background: #ffffff;
  border-radius: 3rpx;
}

.plus::before {
  left: 0;
  top: 50%;
  margin-top: -3rpx;
  width: 34rpx;
  height: 6rpx;
}

.plus::after {
  left: 50%;
  top: 0;
  margin-left: -3rpx;
  width: 6rpx;
  height: 34rpx;
}

.tab-center-txt {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: 500;
}

/* ---------- 注意 ----------
   app.wxss 对自定义组件无效，组件内需要显式声明 border-box，
   否则带边框的图标（房子/时钟/教学楼/头像）尺寸会被撑大 */
.tab-center,
.ic-home .body,
.ic-clock .dial,
.ic-school .wall,
.ic-me .head,
.ic-me .shoulder {
  box-sizing: border-box;
}
