<view class="tabbar">
  <view class="tabbar-inner">
    <!-- 首页 -->
    <view
      class="tab-item {{active === 0 ? 'on' : ''}}"
      data-index="0"
      data-path="/pages/index/index"
      bindtap="onTab">
      <view class="tab-ico ic-home">
        <view class="roof"></view>
        <view class="body"></view>
        <view class="bar"></view>
      </view>
      <view class="tab-txt">首页</view>
    </view>

    <!-- 课时 -->
    <view
      class="tab-item {{active === 1 ? 'on' : ''}}"
      data-index="1"
      data-path="/pages/course/course"
      bindtap="onTab">
      <view class="tab-ico ic-clock">
        <view class="dial"></view>
        <view class="hand-h"></view>
        <view class="hand-m"></view>
        <view class="hand-c"></view>
      </view>
      <view class="tab-txt">课时</view>
    </view>

    <!-- 中间占位：凸起的「+」按钮绝对定位在这一格上 -->
    <!-- 中间占位：凸起的「+」按钮绝对定位在这一格上；整格可点（点偏了也能用） -->
    <!-- 中间占位格：只有凸起的圆形「+」按钮可点，这里不能加 bindtap，
         否则点导航栏中间会误开相机页（相机页没有底部导航，容易被误以为卡住） -->
    <view class="tab-item placeholder"></view>

    <!-- 校园 -->
    <view
      class="tab-item {{active === 2 ? 'on' : ''}}"
      data-index="2"
      data-path="/pages/campus/campus"
      bindtap="onTab">
      <view class="tab-ico ic-school">
        <view class="roof"></view>
        <view class="wall"></view>
        <view class="win w1"></view>
        <view class="win w2"></view>
      </view>
      <view class="tab-txt">校园</view>
    </view>

    <!-- 我的 -->
    <view
      class="tab-item {{active === 3 ? 'on' : ''}}"
      data-index="3"
      data-path="/pages/mine/mine"
      bindtap="onTab">
      <view class="tab-ico ic-me">
        <view class="head"></view>
        <view class="shoulder"></view>
      </view>
      <view class="tab-txt">我的</view>
    </view>
  </view>

  <!-- 中间凸起按钮：点击进入「扫码 / 拍照」二合一页面 -->
  <view
    class="tab-center"
    hover-class="tab-center-hover"
    hover-start-time="0"
    hover-stay-time="120"
    bindtap="onScan">
    <view class="plus"></view>
    <view class="tab-center-txt">扫一扫</view>
  </view>
</view>
