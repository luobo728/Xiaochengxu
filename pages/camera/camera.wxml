<view class="cam" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <!-- 原生相机：授权通过且未进入照片预览时挂载。
       扫码与拍照各用一个实例（切模式时重建），保证 mode 切换在真机上一定生效 -->
  <camera
    wx:if="{{authorized && !photo && mode === 'scan'}}"
    class="cam-view"
    mode="scanCode"
    device-position="{{devicePosition}}"
    flash="{{flash}}"
    bindscancode="onScanCode"
    bindstop="onCameraStop"
    binderror="onCameraError"></camera>
  <camera
    wx:elif="{{authorized && !photo}}"
    class="cam-view"
    mode="normal"
    device-position="{{devicePosition}}"
    flash="{{flash}}"
    resolution="high"
    bindscancode="onScanCode"
    bindstop="onCameraStop"
    binderror="onCameraError"></camera>

  <!-- 权限引导 -->
  <view wx:if="{{ready && !authorized}}" class="cam-tipbox">
    <view class="cam-tip-ico">
      <view class="ico-cam"></view>
    </view>
    <view class="cam-tip-title">需要相机权限</view>
    <view class="cam-tip-sub">用于拍照、扫一扫记录园内活动</view>
    <view class="cam-tip-btn" hover-class="cam-btn-hover" bindtap="openSetting">去开启相机权限</view>
    <view class="cam-tip-link" bindtap="pickFromAlbum">先用相册选一张</view>
  </view>

  <!-- 扫码取景框：4 个 CSS 角标 + 上下往复的扫描线 -->
  <view wx:if="{{authorized && !photo && mode === 'scan'}}" class="cam-scan">
    <view class="cam-scan-box">
      <view class="cam-scan-corner tl"></view>
      <view class="cam-scan-corner tr"></view>
      <view class="cam-scan-corner bl"></view>
      <view class="cam-scan-corner br"></view>
      <view class="cam-scan-line"></view>
    </view>
    <view class="cam-scan-txt">将二维码 / 条形码放入框内</view>
  </view>

  <!-- 顶部操作条 -->
  <view class="cam-top" style="padding-top:{{statusBarHeight}}px">
    <view class="cam-top-btn" hover-class="cam-btn-hover" bindtap="goBack">
      <view class="ico-close"></view>
    </view>
    <view class="cam-top-title">{{mode === 'scan' ? '扫码' : '拍照'}}</view>
    <!-- 右上角留给微信胶囊，这里只放占位以保持标题居中 -->
    <view class="cam-top-btn phantom"></view>
  </view>

  <!-- 识别结果卡片：位于滑块上方，不遮挡滑块与顶部操作条 -->
  <view wx:if="{{authorized && !photo && scanResult}}" class="cam-card {{mode === 'scan' ? 'scan' : 'photo'}}">
    <view class="cam-card-title">识别结果</view>
    <view class="cam-card-text">{{scanResult}}</view>
    <view class="cam-card-btns">
      <view class="cam-card-btn ghost" hover-class="cam-btn-hover" bindtap="clearScanResult">继续扫码</view>
      <view class="cam-card-btn solid" hover-class="cam-btn-hover" bindtap="copyScanResult">复制内容</view>
    </view>
  </view>

  <!-- 模式滑块（分段控件）：点击两格或横滑页面切换 -->
  <view wx:if="{{authorized && !photo}}" class="cam-switch {{mode === 'scan' ? 'scan' : 'photo'}}">
    <view class="cam-switch-thumb {{mode === 'photo' ? 'right' : ''}}"></view>
    <view class="cam-switch-item {{mode === 'scan' ? 'on' : ''}}" data-mode="scan" bindtap="onModeChange">扫码</view>
    <view class="cam-switch-item {{mode === 'photo' ? 'on' : ''}}" data-mode="photo" bindtap="onModeChange">拍照</view>
  </view>

  <!-- 拍照模式：闪光灯 / 快门 / 相册 -->
  <view wx:if="{{authorized && !photo && mode === 'photo'}}" class="cam-bottom">
    <view class="cam-side" hover-class="cam-btn-hover" bindtap="toggleFlash">
      <view class="ico-flash {{flash === 'torch' ? 'on' : ''}}"></view>
      <view class="cam-side-txt">{{flash === 'torch' ? '闪光灯开' : '闪光灯关'}}</view>
    </view>

    <view class="cam-shutter" hover-class="cam-shutter-hover" bindtap="takePhoto">
      <view class="cam-shutter-in"></view>
    </view>

    <view class="cam-side" hover-class="cam-btn-hover" bindtap="pickFromAlbum">
      <view class="ico-album"></view>
      <view class="cam-side-txt">相册</view>
    </view>
  </view>

  <!-- 扫码模式：底部只留滑块 + 一行提示 -->
  <view wx:if="{{authorized && !photo && mode === 'scan'}}" class="cam-scan-tip">对准二维码 / 条形码，自动识别</view>

  <!-- 照片预览 -->
  <view wx:if="{{photo}}" class="cam-preview">
    <image class="cam-preview-img" src="{{photo}}" mode="aspectFit"></image>
    <view class="cam-preview-bar">
      <view class="cam-preview-btn ghost" hover-class="cam-btn-hover" bindtap="retake">重拍</view>
      <view class="cam-preview-btn solid" hover-class="cam-btn-hover" bindtap="usePhoto">使用照片</view>
    </view>
  </view>
</view>
