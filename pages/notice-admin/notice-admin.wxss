/* pages/notice-admin/notice-admin.wxss —— 通知公告管理页样式（通用 class 见 app.wxss） */

/* 底部有导航栏：为它预留高度 */
.page {
  padding-bottom: 220rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部头图（通知主题蓝） ---------- */
.hd-admin {
  background: linear-gradient(135deg, #4C8BFF, #2E6BFF);
}

.hd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

/* 标题已在 .hd-row 内，去掉 app.wxss 里的上间距 */
.hd-admin .hd-title {
  padding-top: 0;
  font-size: 38rpx;
}

.hd-back {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hd-back-hover {
  opacity: 0.7;
}

/* 右上占位：仅为保持标题居中 */
.hd-back.ghost {
  visibility: hidden;
}

/* 返回箭头（两条边框拼出的左尖括号，纯 CSS 无图片） */
.ico-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(45deg);
}

/* ---------- 本机体验模式提示 ---------- */
.mode-tip {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(240, 138, 0, 0.12);
  font-size: 23rpx;
  line-height: 1.6;
  color: #B36A00;
}
/* ---------- 正在修改提示条 ---------- */
.editing-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(46, 107, 255, 0.1);
}

.editing-txt {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #2E6BFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editing-cancel {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #2E6BFF;
  background: #FFFFFF;
}

/* ---------- 表单 ---------- */
.fld {
  margin-bottom: 24rpx;
}

.fld-lbl {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1B1F27;
}

.fld-req {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #E5453D;
  background: rgba(229, 69, 61, 0.1);
}

.fld-tip {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #A6AEBE;
}

.fld-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #F7F9FD;
  font-size: 29rpx;
  color: #1B1F27;
}

.fld-textarea {
  width: 100%;
  height: 260rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #F7F9FD;
  font-size: 29rpx;
  line-height: 1.7;
  color: #1B1F27;
}

.ph {
  color: #A6AEBE;
  font-size: 27rpx;
}

.fld-count {
  margin-top: 10rpx;
  text-align: right;
  font-size: 21rpx;
  color: #A6AEBE;
}

/* 分类胶囊：单选，选中为蓝色实底白字 */
.pills {
  display: flex;
  flex-wrap: wrap;
}

.pill {
  margin: 6rpx 12rpx 6rpx 0;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #5A6273;
  background: #F1F4FA;
}

.pill.on {
  color: #FFFFFF;
  font-weight: 600;
  background: #2E6BFF;
  box-shadow: 0 8rpx 16rpx rgba(46, 107, 255, 0.24);
}

/* ---------- 置顶开关 ---------- */
.opt-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0 6rpx;
}

.opt-lbl {
  flex: 1;
  font-size: 28rpx;
  color: #1B1F27;
}

.opt-hint {
  padding-bottom: 6rpx;
  font-size: 22rpx;
  color: #A6AEBE;
}

.save-btn {
  margin-top: 30rpx;
}

/* ---------- 已有通知列表 ---------- */
.nrow {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}

.nrow.on {
  background: #F7F9FD;
  border-radius: 20rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.nrow-main {
  flex: 1;
  min-width: 0;
}

.nrow-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.nrow-badge {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #E07B00;
  background: rgba(240, 138, 0, 0.14);
}

.nrow-title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  color: #1B1F27;
}

.nrow-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A6AEBE;
}

.nrow-btns {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.mini {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #2E6BFF;
  background: rgba(46, 107, 255, 0.1);
}

.mini.danger {
  margin-top: 12rpx;
  color: #E5453D;
  background: rgba(229, 69, 61, 0.1);
}
.mini + .mini {
  margin-top: 12rpx;
}

.mini.edit {
  color: #FFFFFF;
  background: linear-gradient(135deg, #4C8BFF, #2E6BFF);
  font-weight: 500;
}

.row-hint {
  padding-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A6AEBE;
}

/* ---------- 底部 ---------- */
.reset-row {
  margin: 10rpx auto 0;
  padding: 20rpx 0;
  width: 420rpx;
  text-align: center;
  border-radius: 999rpx;
  border: 2rpx solid #DCE3EF;
  font-size: 26rpx;
  color: #5A6273;
}

.foot-note {
  margin: 24rpx 8rpx 40rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #A6AEBE;
}

/* ---------- 非管理员 ---------- */
.lock-box {
  padding: 16rpx 0 4rpx;
  text-align: center;
}

/* 锁：半圆锁梁 + 方形锁体 */
.ico-lock {
  position: relative;
  width: 84rpx;
  height: 80rpx;
  margin: 8rpx auto 26rpx;
}

.ico-lock::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  width: 54rpx;
  height: 50rpx;
  margin-left: -27rpx;
  box-sizing: border-box;
  border: 8rpx solid #C6CDDA;
  border-bottom: none;
  border-radius: 28rpx 28rpx 0 0;
}

.ico-lock::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 84rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #DCE3EF;
}

.lock-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1B1F27;
}

.lock-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A93A3;
}

.lock-id {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: #A6AEBE;
  word-break: break-all;
}

.lock-tip {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F7F9FD;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8A93A3;
  text-align: left;
}

.btn-back {
  margin-top: 32rpx;
}
