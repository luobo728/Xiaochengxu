<view class="page">
  <view class="hd hd-course" style="padding-top:{{statusBarHeight}}px">
    <view class="hd-title">课时</view>
    <view class="hd-sub">{{kidName}} · 本学期共 {{totalHours}} 课时 · 已完成 {{doneHours}} 课时</view>
    <view class="hd-stats">
      <view class="stat">
        <view class="stat-num">{{totalHours}}</view>
        <view class="stat-lbl">本学期课时</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{doneHours}}</view>
        <view class="stat-lbl">已完成</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{leftHours}}</view>
        <view class="stat-lbl">剩余</view>
      </view>
    </view>
    <view class="hd-pick" hover-class="hd-pick-hover" wx:if="{{multiKid && !kidLock}}" bindtap="onPickKid">切换孩子 ›</view>
  </view>

  <view class="body">
    <!-- 本周课时 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">本周课时</view>
        <view class="tag tag-blue">已完成 {{weekDone}}/{{weekTotal}}</view>
      </view>
      <view class="prog-box">
        <view class="progress">
          <view class="progress-inner" style="width:{{weekPercent}}%"></view>
        </view>
      </view>
      <view class="row" wx:for="{{weekCourses}}" wx:key="id" bindtap="onMoreTap">
        <view class="row-ico" style="background:{{item.bg}}">{{item.ico}}</view>
        <view class="row-main">
          <view class="row-name">{{item.name}}</view>
          <view class="row-sub">{{item.sub}}</view>
          <view class="row-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
        </view>
        <view class="row-val">{{item.val}}</view>
      </view>
    </view>

    <!-- 课时明细 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">课时明细</view>
        <view class="card-more" bindtap="onMoreTap">近 30 天</view>
      </view>
      <view class="row" wx:for="{{records}}" wx:key="id" bindtap="onMoreTap">
        <view class="row-sub rec-date">{{item.date}}</view>
        <view class="row-main">
          <view class="row-name">{{item.name}}</view>
          <view class="row-sub">{{item.teacher}}</view>
        </view>
        <view class="row-val {{item.gray ? 'gray' : ''}}">{{item.val}}</view>
      </view>
      <view class="hairline"></view>
      <view class="card-more more-row" bindtap="onMoreTap">查看全部课时记录 ›</view>
    </view>
  </view>
</view>
