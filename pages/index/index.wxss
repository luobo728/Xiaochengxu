/* pages/index/index.wxss —— 首页：顶部红色活动滚动屏 + 白色内容区
   红色区域对应设计稿上半部分，底部公告条即设计稿红色区域底部那条浅色横条 */

/* ========== 顶部红色滚动屏 ========== */
.hero {
  position: relative;
  padding-bottom: 34rpx;
  border-radius: 0 0 36rpx 36rpx;
  background: linear-gradient(160deg, #FF6A5B 0%, #F5333F 46%, #D81E2E 100%);
  box-shadow: 0 16rpx 40rpx rgba(216, 30, 46, 0.28);
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
}

.hero-glow.g1 {
  left: -120rpx;
  top: -150rpx;
  width: 420rpx;
  height: 420rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-glow.g2 {
  right: -140rpx;
  bottom: -170rpx;
  width: 380rpx;
  height: 380rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* ---- 头部：园所名 + 铃铛 ---- */
.hero-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 18rpx 32rpx 28rpx;
}

.hero-head-l {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 0 1 auto;
}

.hero-logo {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-head-txt {
  min-width: 0;
  overflow: hidden;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero-welcome {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---- 活动滚动屏 ---- */
.act-swiper {
  position: relative;
  z-index: 2;
  height: 300rpx;
  margin: 0 32rpx;
}

.act-card {
  position: relative;
  height: 280rpx;
  margin-top: 6rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.18);
}

.act-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.act-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, rgba(10, 16, 40, 0.78) 8%, rgba(10, 16, 40, 0.12) 100%);
}

.act-info {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.act-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.4;
}

.act-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.32;
}

.act-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.45;
}

.act-thumb {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  width: 132rpx;
  height: 132rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.act-dots {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
  transition: width 0.25s ease, background 0.25s ease;
}

.dot.on {
  width: 28rpx;
  border-radius: 6rpx;
  background: #ffffff;
}

/* ---- 公告跑马灯：无缝横向滚动 ---- */
.marquee {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  height: 64rpx;
  margin: 22rpx 32rpx 0;
  padding: 0 16rpx 0 12rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.2);
}

.marquee-tag {
  flex-shrink: 0;
  margin-right: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #F5333F;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.5;
}

.marquee-view {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  overflow: hidden;
  white-space: nowrap;
}

.marquee-track {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  white-space: nowrap;
  animation-name: marquee-run;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

/* 页面不可见时暂停滚动，省下性能 */
.marquee-track.paused {
  animation-play-state: paused;
}

.marquee-item {
  flex-shrink: 0;
  padding-right: 80rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.94);
  white-space: nowrap;
}

@keyframes marquee-run {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* ========== 内容区 ========== */
.body {
  position: relative;
  z-index: 3;
  padding: 26rpx 24rpx 0;
}

/* ---- 今日食谱（一行入口：图标 + 名称 + 一句说明 + 箭头） ---- */
.entry {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(24, 40, 80, 0.06);
}

.entry-hover {
  opacity: 0.8;
}

.entry-ico {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(24, 40, 80, 0.14);
}

.entry-main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.entry-name {
  font-size: 29rpx;
  font-weight: 500;
  color: #1B1F27;
}

.entry-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A93A3;
}

/* ---- 今日安排 ---- */
.plan {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.plan-time {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2E6BFF;
}

.plan-line {
  flex-shrink: 0;
  width: 24rpx;
  display: flex;
  justify-content: center;
}

.plan-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #D7DEEC;
}

.plan.done .plan-dot {
  background: #2E6BFF;
}

.plan-main {
  flex: 1;
  min-width: 0;
  padding-left: 16rpx;
}

.plan-name {
  font-size: 29rpx;
  font-weight: 500;
  color: #1B1F27;
}

.plan-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A93A3;
}

.plan-status {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F1F4FA;
  color: #8A93A3;
  font-size: 21rpx;
  line-height: 1.5;
}

.plan-status.cur {
  background: rgba(46, 107, 255, 0.1);
  color: #2E6BFF;
  font-weight: 500;
}

/* ---- 最新通知 ---- */
.notice {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.notice-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #2E6BFF;
}

.notice:nth-child(2) .notice-dot {
  background: #F08A00;
}

.notice:nth-child(3) .notice-dot {
  background: #12A182;
}

.notice:nth-child(4) .notice-dot {
  background: #F0432B;
}

.notice-main {
  flex: 1;
  min-width: 0;
}

.notice-title {
  font-size: 28rpx;
  color: #1B1F27;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A93A3;
}

.foot-tip {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B4BBC8;
  letter-spacing: 2rpx;
}

/* 卡片标题旁的日期（原顶部欢迎语里的日期挪到这里） */
.card-date {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #8A93A3;
}
