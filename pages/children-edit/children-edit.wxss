/* pages/children-edit/children-edit.wxss —— 建立 / 编辑孩子档案（通用 class 见 app.wxss） */

/* 底部有导航栏：为它预留高度 */
.page {
  padding-bottom: 220rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部头图（档案主题蓝） ---------- */
.hd-kid {
  background: linear-gradient(135deg, #6E8BFF, #2E6BFF);
}

.hd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

/* 标题已在 .hd-row 内，去掉 app.wxss 里的上间距 */
.hd-kid .hd-title {
  padding-top: 0;
  font-size: 38rpx;
}

.hd-back {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hd-back-hover {
  opacity: 0.7;
}

/* 右上占位：仅为保持标题居中 */
.hd-back.ghost {
  visibility: hidden;
}

/* 返回箭头（两条边框拼出的左尖括号，纯 CSS 无图片） */
.ico-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(45deg);
}

/* ---------- 说明条 ---------- */
/* 演示提示：数据存在本机 */
.mode-tip {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(240, 138, 0, 0.12);
  font-size: 22rpx;
  line-height: 1.6;
  color: #B36A00;
}

/* ---------- 表单 ---------- */
.fld {
  margin-bottom: 24rpx;
}

/* 最后一个字段：不要多出一个空档 */
.fld.last {
  margin-bottom: 0;
}

.fld-lbl {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1B1F27;
}

/* 「必填」小标签 */
.fld-req {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #E5453D;
  background: rgba(229, 69, 61, 0.1);
}

.fld-tip {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #A6AEBE;
}

.fld-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #F7F9FD;
  font-size: 29rpx;
  color: #1B1F27;
}

/* picker 里当展示框用：文字垂直居中，右边给个「可点」的小箭头感 */
.pick-value {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  color: #1B1F27;
}

/* 备注：多行输入 */
.fld-area {
  box-sizing: border-box;
  width: 100%;
  height: 150rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #F7F9FD;
  font-size: 27rpx;
  line-height: 1.5;
  color: #1B1F27;
}

/* 字段下面那句话（为什么不能重名） */
.fld-tip-line {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #A6AEBE;
}

/* ---------- 性别：小圆片 ---------- */
.pills {
  display: flex;
  flex-wrap: wrap;
}

.pill {
  margin: 6rpx 12rpx 6rpx 0;
  padding: 10rpx 40rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #5A6273;
  background: #F1F4FA;
}

.pill.on {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #6E8BFF, #2E6BFF);
  box-shadow: 0 8rpx 16rpx rgba(46, 107, 255, 0.24);
}

/* ---------- 这个孩子自己的课时 ---------- */
.left-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #5A6273;
}

/* 「＋3 课时（测试用）」：演示账号 + 管理员才画；描边小按钮，别和「保存修改」抢眼 */
.add3-btn {
  margin-top: 20rpx;
  padding: 20rpx 0;
  width: 380rpx;
  border-radius: 999rpx;
  border: 2rpx solid #C9D6FF;
  background: #F2F6FF;
  font-size: 25rpx;
  color: #2E6BFF;
  text-align: center;
}

.add3-btn-hover {
  opacity: 0.85;
}

.add3-tip {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #A6AEBE;
}

/* ---------- 按钮 ---------- */
.save-btn {
  margin-top: 28rpx;
  padding: 26rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6E8BFF, #2E6BFF);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.save-btn-hover {
  opacity: 0.85;
}

/* 删除：红字 + 描边，别做成大按钮误点 */
.del-btn {
  margin: 20rpx auto 0;
  padding: 22rpx 0;
  width: 420rpx;
  border-radius: 999rpx;
  border: 2rpx solid #FFD5D2;
  background: #FFF6F5;
  font-size: 25rpx;
  color: #E5453D;
  text-align: center;
}

/* ---------- 底部 ---------- */
.foot-note {
  margin: 24rpx 8rpx 40rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #A6AEBE;
}

/* ---------- 不是管理员 ---------- */
.lock-box {
  padding: 16rpx 0 4rpx;
  text-align: center;
}

/* 锁：半圆锁梁 + 方形锁体 */
.ico-lock {
  position: relative;
  width: 84rpx;
  height: 80rpx;
  margin: 8rpx auto 26rpx;
}

.ico-lock::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  width: 54rpx;
  height: 50rpx;
  margin-left: -27rpx;
  box-sizing: border-box;
  border: 8rpx solid #C6CDDA;
  border-bottom: none;
  border-radius: 28rpx 28rpx 0 0;
}

.ico-lock::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 84rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #DCE3EF;
}

.lock-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1B1F27;
}

.lock-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A93A3;
}

/* 当前身份（例如「管理员 · 王老师」），让人知道为什么进不来 */
.lock-me {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8A93A3;
}

.lock-demo {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FFF6EA;
  border: 1rpx solid #FFDCB0;
  font-size: 22rpx;
  line-height: 1.6;
  color: #A25B00;
  text-align: left;
}

.btn-back {
  margin-top: 32rpx;
}
