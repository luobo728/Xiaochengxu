<view class="page">
  <view class="hd hd-kid" style="padding-top:{{statusBarHeight}}px">
    <view class="hd-row">
      <view class="hd-back" hover-class="hd-back-hover" bindtap="goBack"><view class="ico-back"></view></view>
      <view class="hd-title">{{title}}</view>
      <view class="hd-back ghost"></view>
    </view>
    <view class="hd-sub">{{sub}}</view>
  </view>

  <view class="body">
    <!-- 三分支：正在校验 / 改不了（锁卡片）/ 能改（三分支必须相邻，中间不夹注释） -->
    <view class="empty" wx:if="{{!checked}}">正在校验身份…</view>
    <view class="card" wx:elif="{{!canEdit}}">
      <view class="lock-box">
        <view class="ico-lock"></view>
        <view class="lock-title">建档只有管理员能做</view>
        <view class="lock-sub">孩子档案是点名名单的唯一来源：建了档才能给他点名、扣他的课时</view>
        <view class="lock-me" wx:if="{{curName}}">当前身份：{{curName}}</view>
        <view class="lock-demo" wx:if="{{demoLock}}">{{demoLock}}</view>
        <view class="btn-primary btn-back" bindtap="goBack">返回</view>
      </view>
    </view>
    <block wx:else>
      <view class="mode-tip">{{modeTip}}</view>

      <view class="card">
        <view class="card-head">
          <view class="card-title">孩子信息</view>
          <view class="card-more">只有姓名必填</view>
        </view>

        <view class="fld">
          <view class="fld-lbl">姓名<text class="fld-req">必填</text></view>
          <input
            class="fld-input"
            value="{{name}}"
            placeholder="孩子的名字，最多 8 个字"
            maxlength="8"
            data-key="name"
            bindinput="onInput" />
          <view class="fld-tip-line">同一个班不能有重名的孩子 —— 重名会点错人</view>
        </view>

        <view class="fld">
          <view class="fld-lbl">性别</view>
          <view class="pills">
            <view
              class="pill {{item.on ? 'on' : ''}}"
              wx:for="{{sexList}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="onPickSex">{{item.key}}</view>
          </view>
        </view>

        <view class="fld">
          <view class="fld-lbl">生日<text class="fld-tip">选填，用来自动算年龄</text></view>
          <picker mode="date" value="{{birthday}}" end="{{today}}" bindchange="onBirth">
            <view class="fld-input pick-value">{{birthday || '点这里选生日'}}</view>
          </picker>
        </view>

        <view class="fld">
          <view class="fld-lbl">班级<text class="fld-tip">点名表里的班级就是这个</text></view>
          <picker range="{{clsList}}" value="{{clsIndex}}" bindchange="onCls">
            <view class="fld-input pick-value">{{cls}}</view>
          </picker>
        </view>

        <view class="fld">
          <view class="fld-lbl">家长称呼<text class="fld-tip">选填</text></view>
          <input
            class="fld-input"
            value="{{parentName}}"
            placeholder="例如 乐乐妈妈"
            maxlength="10"
            data-key="parentName"
            bindinput="onInput" />
        </view>

        <view class="fld">
          <view class="fld-lbl">家长手机号<text class="fld-tip">选填，11 位数字</text></view>
          <input
            class="fld-input"
            type="number"
            value="{{parentPhone}}"
            placeholder="13800000000"
            maxlength="11"
            data-key="parentPhone"
            bindinput="onInput" />
        </view>

        <view class="fld last">
          <view class="fld-lbl">备注<text class="fld-tip">选填，最多 40 字</text></view>
          <textarea
            class="fld-area"
            value="{{note}}"
            placeholder="例如 对花生过敏 / 下午要早接"
            maxlength="40"
            data-key="note"
            bindinput="onInput" />
        </view>
      </view>

      <view class="card" wx:if="{{editId}}">
        <view class="card-head">
          <view class="card-title">这个孩子的课时</view>
          <view class="card-more">按孩子独立记账</view>
        </view>
        <view class="left-text">{{leftText}}</view>
        <view class="add3-btn" wx:if="{{canEdit && demo}}" hover-class="add3-btn-hover" bindtap="onAdd3">＋3 课时（测试用）</view>
        <view class="add3-tip" wx:if="{{canEdit && demo}}">点一次给这个孩子补 3 课时，可以重复点 —— 只用来试「点名扣课时」。</view>
      </view>

      <view class="save-btn" hover-class="save-btn-hover" bindtap="onSave">{{saving ? '正在保存…' : (editId ? '保存修改' : '建立档案')}}</view>
      <view class="del-btn" wx:if="{{editId}}" bindtap="onDelete">删除这个孩子的档案</view>

      <view class="foot-note">建好档以后：这个孩子立刻出现在「点名」名单里；点一次名只扣他自己的课时，几个孩子各记一本账、互不影响；「课时」页选中他，看的就是他自己那本明细。演示说明：打开「点名」或「课时」页时会给每个孩子各送 20 演示课时（一人只送一次），新建档的孩子下次进点名页也会自动各送 20 课时，不用手工加。删档案只删名单，课时流水不会丢。</view>
    </block>
  </view>

  <!-- 底部导航：子页面也能直接切换模块（高亮「我的」） -->
  <tab-bar selected="{{3}}" plain="{{true}}" />
</view>
