/* 校园页 */

/* 头图主题色 */
.hd-campus {
  background: linear-gradient(135deg, #3FC5A0, #12A182);
}

/* 班级相册：三列网格（纯 CSS 色块，无图片） */
.album {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.album-item {
  width: 200rpx;
  margin-bottom: 20rpx;
}

.album-thumb {
  height: 160rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.album-cap {
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8A93A3;
}

/* 食谱星期列 */
.menu-day {
  width: 110rpx;
  flex-shrink: 0;
}

/* 园区监控：深色渐变图标 + 在线 / 离线 */
.mon-ico {
  background: linear-gradient(135deg, #3C4657, #1B2231);
}

.mon-on {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.mon-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #12A182;
}

.mon-on-txt {
  font-size: 22rpx;
  color: #8A93A3;
}

.mon-off {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #A6AEBE;
}
