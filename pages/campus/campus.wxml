<view class="page">
  <view class="hd hd-campus" style="padding-top:{{statusBarHeight}}px">
    <view class="hd-title">校园</view>
    <view class="hd-sub">春晖园 · 大一班 · 今日出勤 {{attendToday}}/{{attendTotal}}</view>
    <view class="hd-stats">
      <view class="stat">
        <view class="stat-num">{{attendToday}}</view>
        <view class="stat-lbl">今日出勤</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{weekEvents}}</view>
        <view class="stat-lbl">本周活动</view>
      </view>
    </view>
  </view>

  <view class="body">

    <!-- 园区监控：最想被家长看到的入口，放在第一张卡片 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">园区监控</view>
        <view wx:if="{{monitorReady}}" class="card-more" bindtap="onCamTap">{{camTotal ? camTotal + ' 路画面' : '查看全部 ›'}}</view>
        <view wx:else class="card-more tag tag-gray" bindtap="onCamTap">即将开放</view>
      </view>

      <!-- 已接入：最多前 3 路，右侧显示在线 / 离线 -->
      <view class="row" wx:for="{{cameras}}" wx:key="id" data-id="{{item.id}}" bindtap="onCamTap">
        <view class="row-ico mon-ico">监</view>
        <view class="row-main">
          <view class="row-name">{{item.name}}</view>
          <view class="row-sub">{{item.place}}{{windowText ? ' · ' + windowText : ''}}</view>
        </view>
        <view wx:if="{{item.online}}" class="mon-on">
          <view class="mon-dot"></view>
          <view class="mon-on-txt">在线</view>
        </view>
        <view wx:else class="mon-off">离线</view>
        <view class="arrow"></view>
      </view>

      <!-- 已接入但确实没有可用画面 -->
      <view wx:if="{{monitorReady && camLoaded && cameras.length === 0}}" class="row">
        <view class="row-main">
          <view class="row-sub">暂无可用画面</view>
        </view>
      </view>

      <!-- 未接入：整行只显示一条灰字提示 -->
      <view wx:if="{{!monitorReady}}" class="row" bindtap="onCamTap">
        <view class="row-main">
          <view class="row-sub">监控正在对接中，敬请期待</view>
        </view>
      </view>

      <!-- 超过 3 路时给出「查看全部」入口 -->
      <view wx:if="{{monitorReady && camTotal > 3}}" class="row" bindtap="onCamTap">
        <view class="row-main">
          <view class="row-sub">查看全部 {{camTotal}} 路 ›</view>
        </view>
      </view>
    </view>

    <!-- 校园快讯 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">校园快讯</view>
        <view class="card-more" bindtap="onMoreTap">全部</view>
      </view>
      <view class="row" wx:for="{{news}}" wx:key="id" bindtap="onMoreTap">
        <view class="row-ico" style="background:{{item.bg}}">{{item.ico}}</view>
        <view class="row-main">
          <view class="row-name">{{item.title}}</view>
          <view class="row-sub">{{item.time}}</view>
        </view>
        <view class="arrow"></view>
      </view>
    </view>

    <!-- 班级相册 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">班级相册</view>
        <view class="card-more" bindtap="onMoreTap">更多</view>
      </view>
      <view class="album">
        <view class="album-item" wx:for="{{album}}" wx:key="id" bindtap="onMoreTap">
          <view class="album-thumb" style="background:{{item.bg}}">{{item.word}}</view>
          <view class="album-cap">{{item.cap}}</view>
        </view>
      </view>
    </view>

    <!-- 本周食谱 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">本周食谱</view>
        <view class="tag tag-green">每日更新</view>
      </view>
      <view class="row" wx:for="{{menu}}" wx:key="day">
        <view class="row-name menu-day">{{item.day}}</view>
        <view class="row-main">
          <view class="row-sub">{{item.dish}}</view>
        </view>
        <view class="tag tag-orange">午餐</view>
      </view>
    </view>
  </view>
</view>
