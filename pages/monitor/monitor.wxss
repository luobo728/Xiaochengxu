/* pages/monitor/monitor.wxss —— 监控播放页：深色底 + 播放器 + 切换 + 信息卡 */

page {
  background: #0B0D12;
  color: #ffffff;
}

/* 二级页面：不放 tabBar，底部只留安全区 */
.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.mon-hover {
  opacity: 0.7;
}

/* ---------- 顶部操作条 ---------- */
.mon-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 16rpx;
}

.mon-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 返回箭头：左 + 下边框旋转 45 度 */
.mon-arrow {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

/* 右上占位：仅为保持标题居中（微信胶囊占据该区域） */
.mon-back.phantom {
  visibility: hidden;
}

.mon-top-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ---------- 播放区（16:9） ---------- */
.mon-player {
  position: relative;
  width: 750rpx;
  height: 422rpx;
  background: #000000;
}

.mon-video {
  width: 100%;
  height: 100%;
}

/* ---------- 占位层 ---------- */
.mon-ph {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.mon-ph-ico,
.mon-spin {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 28rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 摄像头图标（纯 CSS，无图片资源） */
.mon-cam-ico {
  position: relative;
  width: 52rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 10rpx;
}

.mon-cam-ico::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  margin-left: -9rpx;
  margin-top: -9rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
}

.mon-cam-ico::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: -12rpx;
  width: 18rpx;
  height: 8rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: rgba(255, 255, 255, 0.85);
}

/* 伪元素不继承 app.wxss 的 box-sizing，带边框的要显式声明 */
.mon-cam-ico::before,
.mon-cam-ico::after {
  box-sizing: border-box;
}

/* 取流中：转圈 */
.mon-spin {
  border: 5rpx solid rgba(255, 255, 255, 0.16);
  border-top-color: #12A182;
  animation: mon-rot 0.9s linear infinite;
}

@keyframes mon-rot {
  to {
    transform: rotate(360deg);
  }
}

.mon-ph-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.mon-ph-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
}

.mon-btn {
  margin-top: 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 56rpx;
  border-radius: 36rpx;
  background: #12A182;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 当前画面信息 + 在线状态 ---------- */
.mon-now {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 0;
}

.mon-now-name {
  max-width: 520rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mon-on {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.mon-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #12A182;
}

.mon-on-txt {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.mon-off {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* ---------- 摄像头切换胶囊 ---------- */
.mon-cams {
  width: 100%;
  padding: 24rpx 32rpx 0;
  white-space: nowrap;
}

.mon-cam {
  display: inline-block;
  margin-right: 16rpx;
  padding: 0 30rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.mon-cam.on {
  background: #12A182;
  color: #ffffff;
  font-weight: 600;
}

/* ---------- 信息卡 ---------- */
.mon-card {
  margin: 32rpx 32rpx 0;
  padding: 0 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
}

.mon-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.mon-card-lbl {
  flex-shrink: 0;
  margin-right: 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
}

.mon-card-val {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: right;
}

.mon-line {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
}

.mon-note {
  margin-top: 22rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.4);
}
