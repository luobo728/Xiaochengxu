/* pages/children/children.wxss —— 孩子档案页样式（通用 class 见 app.wxss） */

/* 底部有导航栏：为它预留高度 */
.page {
  padding-bottom: 220rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部头图（档案主题蓝） ---------- */
.hd-kid {
  background: linear-gradient(135deg, #6E8BFF, #2E6BFF);
}

.hd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

/* 标题已在 .hd-row 内，去掉 app.wxss 里的上间距 */
.hd-kid .hd-title {
  padding-top: 0;
  font-size: 38rpx;
}

.hd-back {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hd-back-hover {
  opacity: 0.7;
}

/* 右上占位：仅为保持标题居中 */
.hd-back.ghost {
  visibility: hidden;
}

/* 返回箭头（两条边框拼出的左尖括号，纯 CSS 无图片） */
.ico-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(45deg);
}

/* ---------- 说明条 ---------- */
/* 演示提示：数据存在本机 */
.mode-tip {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(240, 138, 0, 0.12);
  font-size: 22rpx;
  line-height: 1.6;
  color: #B36A00;
}

/* 家长端：只能看自己孩子的档案 */
.parent-tip {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(46, 107, 255, 0.12);
  font-size: 22rpx;
  line-height: 1.6;
  color: #2E6BFF;
}

/* 老师端：能干什么 */
.staff-tip {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(76, 139, 255, 0.12);
  font-size: 22rpx;
  line-height: 1.6;
  color: #2E6BFF;
}

/* ---------- 档案一行 ---------- */
.row-kid {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.row-kid-hover {
  opacity: 0.7;
}

/* 头像方块：只用 CSS 渐变 + 一个字，项目里不用图片 */
.ava {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  margin-right: 20rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.k-head {
  display: flex;
  align-items: center;
}

/* 性别小标签（男 / 女） */
.sex-tag {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.sex-boy {
  background: #E4EEFF;
  color: #2E6BFF;
}

.sex-girl {
  background: #FFE9F0;
  color: #E0529A;
}

/* 右边一栏：剩几课时 + 已扣几课时 */
.k-right {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
}

.k-spent {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #A6AEBE;
}

/* 课时快用完了：数字标红（和 .row-val 一起用） */
.low {
  color: #E05252;
}

/* 名单下面那句话 */
.row-hint {
  padding-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #A6AEBE;
}

/* 只能看时说清楚为什么改不了 */
.lock-tip {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #F7F9FD;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8A93A3;
}

/* ---------- 按钮 ---------- */
.save-btn {
  margin-top: 28rpx;
  padding: 26rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6E8BFF, #2E6BFF);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.save-btn-hover {
  opacity: 0.85;
}

/* 「去点名」：次要按钮 */
.alt-btn {
  margin: 20rpx 0 0;
  padding: 24rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid #DCE3EF;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #2E6BFF;
  text-align: center;
}

.alt-btn-hover {
  opacity: 0.8;
}

/* ---------- 「怎么用」步骤 ---------- */
.step {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.step-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #E4EEFF;
  font-size: 22rpx;
  font-weight: 600;
  color: #2E6BFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-txt {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.6;
  color: #5A6273;
}

/* ---------- 底部 ---------- */
.foot-note {
  margin: 24rpx 8rpx 40rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #A6AEBE;
}
