/* 我的页 */

/* 头图主题色 */
.hd-mine {
  background: linear-gradient(135deg, #FF6A5B, #F0343C);
}

/* 孩子头像：88rpx 圆形渐变底 + 白色单字 */
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #59A2FF, #2E6BFF);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

/* 三列小统计 */
.mini-stats {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F2F7;
}

.mini-stat {
  flex: 1;
  text-align: center;
}

.mini-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #1B1F27;
}

.mini-lbl {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A93A3;
}

/* 退出登录区 */
.logout-box {
  margin-top: 8rpx;
}

.foot-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8A93A3;
}

/* ---------- 课时与余额卡片 ---------- */
.bill-nums {
  display: flex;
  align-items: center;
  padding: 6rpx 0 4rpx;
}

.bill-num {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.bill-num-v {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #1B1F27;
}

.bill-num-l {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A93A3;
}

/* 两栏大数字之间的竖分隔线 */
.bill-split {
  flex-shrink: 0;
  width: 1rpx;
  height: 64rpx;
  background: #F0F2F7;
}

.bill-state {
  margin-top: 16rpx;
  text-align: center;
  font-size: 23rpx;
  color: #8A93A3;
}

.bill-btns {
  display: flex;
  margin-top: 24rpx;
}

.bill-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 两个按钮之间留出间距 */
.bill-btn + .bill-btn {
  margin-left: 20rpx;
}

.bill-btn-claim {
  background: linear-gradient(135deg, #59A2FF, #2E6BFF);
  box-shadow: 0 10rpx 20rpx rgba(46, 107, 255, 0.22);
}

.bill-btn-checkin {
  background: linear-gradient(135deg, #3FC5A0, #12A182);
  box-shadow: 0 10rpx 20rpx rgba(18, 161, 130, 0.22);
}

/* 已打卡：浅灰底灰字，只作状态展示，点击不再请求 */
.bill-btn-done {
  background: #F1F4FA;
  color: #8A93A3;
}

/* 请求进行中：两个按钮一起变淡，配合 showLoading 提示 */
.bill-btn.is-busy {
  opacity: 0.6;
}

.bill-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8A93A3;
}

/* ---------- 登录 / 账号卡片 ---------- */

/* 登录输入框：浅灰底，圆角 20rpx，高 88rpx */
.lg-input {
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #F4F6FA;
  font-size: 28rpx;
  color: #1B1F27;
}

.lg-input::placeholder {
  color: #A9B2C0;
}

/* 登录按钮沿用 .btn-primary 视觉，只补间距与禁用态 */
.lg-btn {
  margin-top: 8rpx;
}

/* 提交中：变淡，配合 JS 里的 logging 防连点 */
.lg-btn.is-busy {
  opacity: 0.6;
}

.lg-tip {
  margin-top: 22rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8A93A3;
}
/* ---------- 微信一键登录 ---------- */

/* 主按钮：微信绿渐变，高 96rpx / 圆角 48rpx */
.wx-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #3ED39A, #07C160);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(7, 193, 96, 0.24);
}

/* 登录中：变淡，配合 JS 里的 wxLogging 防连点 */
.wx-btn.is-busy {
  opacity: 0.6;
}

/* 纯 CSS 图标：白色圆角方块，像聊天气泡（不使用任何图片 / 官方 logo） */
.wx-ico {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
}

/* 方块上的两个小点：取按钮主色，白底上才看得见（纯白会糊成一片） */
.wx-dot {
  position: absolute;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #23CA7D;
}

.wx-dot-a {
  left: 10rpx;
}

.wx-dot-b {
  right: 10rpx;
}

.wx-tip {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8A93A3;
}

/* 备用入口：展开 / 收起「姓名 + 手机号」表单 */
.wx-alt {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8A93A3;
}

/* 展开后的备用登录表单 */
.lg-form {
  margin-top: 20rpx;
}

/* 已登录：左头像方块 + 中间姓名手机号 + 右标签 */
.acct-row {
  display: flex;
  align-items: center;
}

.acct-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #3C4657, #1B2231);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.acct-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1B1F27;
}

/* 登录时间与「切换账号」同一行分布两端 */
.acct-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F2F7;
}

.acct-time {
  font-size: 22rpx;
  color: #8A93A3;
}

.acct-switch {
  font-size: 24rpx;
  color: #8A93A3;
}

/* 资料不完整（缺姓名 / 手机号）时卡片底部的补充入口 */
.acct-extra {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2E6BFF;
}

/* 手机号为空：用更浅的灰字提示 */
.row-sub.is-empty {
  color: #A9B2C0;
}
