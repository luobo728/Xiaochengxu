<view class="page">
  <view class="hd hd-mine" style="padding-top:{{statusBarHeight}}px">
    <view class="hd-title">我的</view>
    <view class="hd-sub">{{logged ? '家长账号 · 已绑定 1 名幼儿' : '未登录 · 请先登录'}}</view>
  </view>

  <view class="body">
    <!-- 家长登录：未登录时主推微信一键登录，备用表单按需展开 -->
    <view class="card" wx:if="{{!logged}}">
      <view class="card-head">
        <view class="card-title">家长登录</view>
        <view class="card-more">无需注册</view>
      </view>

      <!-- 主入口：微信一键登录（左侧图标为纯 CSS 绘制） -->
      <view class="wx-btn {{wxLogging ? 'is-busy' : ''}}" bindtap="onWxLogin">
        <view class="wx-ico">
          <view class="wx-dot wx-dot-a"></view>
          <view class="wx-dot wx-dot-b"></view>
        </view>
        <view>{{wxLogging ? '登录中…' : '微信一键登录'}}</view>
      </view>
      <view class="wx-tip">一键登录，无需注册；登录后可使用课时余额、账单明细等功能</view>

      <!-- 次要入口：展开 / 收起「姓名 + 手机号」备用表单 -->
      <view class="wx-alt" bindtap="onToggleForm">用姓名·手机号登录 ›</view>

      <view class="lg-form" wx:if="{{formOpen}}">
        <input class="lg-input" placeholder="请输入姓名" value="{{loginName}}" bindinput="onNameInput" maxlength="20" confirm-type="done" />
        <input class="lg-input" type="number" placeholder="请输入手机号" value="{{loginPhone}}" bindinput="onPhoneInput" maxlength="11" confirm-type="done" />
        <view class="btn-primary lg-btn {{logging ? 'is-busy' : ''}}" bindtap="onLogin">{{logging ? '登录中…' : '登 录'}}</view>
        <view class="lg-tip">演示账号：姓名 {{demoName}} / 手机号 {{demoPhone}}</view>
      </view>
    </view>

    <!-- 已登录：账号卡片（微信一键登录可能还没填姓名 / 手机号） -->
    <view class="card" wx:else>
      <view class="acct-row">
        <view class="acct-avatar">{{userInitial}}</view>
        <view class="row-main">
          <view class="acct-name">{{userName || '微信用户'}}</view>
          <view class="row-sub {{userPhone ? '' : 'is-empty'}}">{{userPhone || '未绑定手机号'}}</view>
        </view>
        <view class="tag tag-green">已登录</view>
      </view>
      <view class="acct-foot">
        <view class="acct-time">登录时间：{{loginAtText}}</view>
        <view class="acct-switch" bindtap="onSwitchAccount">切换账号 ›</view>
      </view>
      <!-- 缺姓名或手机号时才出现的补充入口 -->
      <view class="acct-extra" wx:if="{{!userName || !userPhone}}" bindtap="onEditProfile">完善资料（姓名与手机号）›</view>
    </view>

    <!-- 孩子档案：需要账号，未登录时整卡隐藏 -->
    <view class="card" wx:if="{{logged}}">
      <view class="card-head">
        <view class="card-title">孩子档案</view>
        <view class="card-more" bindtap="onMoreTap">编辑</view>
      </view>
      <view class="row" bindtap="onMoreTap">
        <view class="row-ico avatar">{{child.avatar}}</view>
        <view class="row-main">
          <view class="row-name">{{child.name}}</view>
          <view class="row-sub">{{child.sub}}</view>
        </view>
        <view class="tag tag-green">已认证</view>
      </view>
      <view class="mini-stats">
        <view class="mini-stat" wx:for="{{miniStats}}" wx:key="id">
          <view class="mini-num">{{item.num}}</view>
          <view class="mini-lbl">{{item.lbl}}</view>
        </view>
      </view>
    </view>

    <!-- 课时与余额：数值与规则都来自 utils/billing.js；需要账号，未登录时整卡隐藏 -->
    <view class="card" wx:if="{{logged}}">
      <view class="card-head">
        <view class="card-title">课时与余额</view>
        <view class="card-more" bindtap="onBillingDetail">账单明细 ›</view>
      </view>

      <view class="bill-nums">
        <view class="bill-num">
          <view class="bill-num-v">{{hours}}</view>
          <view class="bill-num-l">课时余额</view>
        </view>
        <view class="bill-split"></view>
        <view class="bill-num">
          <view class="bill-num-v">¥{{balanceText}}</view>
          <view class="bill-num-l">账户余额</view>
        </view>
      </view>

      <view class="bill-state">连续打卡 {{checkinDays}} 天 · {{todayChecked ? '今日已打卡' : '今日未打卡'}}</view>

      <view class="bill-btns">
        <view class="bill-btn bill-btn-claim {{billingBusy ? 'is-busy' : ''}}" bindtap="onScanClaim">扫码领课时</view>
        <view class="bill-btn {{todayChecked ? 'bill-btn-done' : 'bill-btn-checkin'}} {{billingBusy ? 'is-busy' : ''}}" bindtap="onCheckin">{{todayChecked ? '今日已打卡 ✔' : '今日打卡'}}</view>
      </view>

      <view class="bill-tip">新生扫码领 {{claimHours}} 课时 · 每天打卡返 ¥{{checkinReward}} 余额</view>
    </view>

    <!-- 常用功能 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">常用功能</view>
      </view>
      <view class="row" wx:for="{{tools}}" wx:key="id" bindtap="onMoreTap">
        <view class="row-ico" style="background:{{item.bg}}">{{item.ico}}</view>
        <view class="row-main">
          <view class="row-name">{{item.name}}</view>
          <view class="row-sub">{{item.sub}}</view>
        </view>
        <view class="arrow"></view>
      </view>
      <!-- 班级相册：所有家长都能看本班 + 全园的照片 -->
      <view class="row" bindtap="onAlbumTap">
        <view class="row-ico" style="background:linear-gradient(135deg,#FFB07C,#F2703F)">册</view>
        <view class="row-main">
          <view class="row-name">班级相册</view>
          <view class="row-sub">{{albumSub}}</view>
        </view>
        <view class="arrow"></view>
      </view>
    </view>

    <!-- 设置 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">设置</view>
      </view>
      <!-- 食谱管理入口（仅管理员可见） -->
      <view class="row" wx:if="{{isAdmin}}" bindtap="onAdminTap">
        <view class="row-ico" style="background:linear-gradient(135deg,#FFB020,#F08A00)">谱</view>
        <view class="row-main"><view class="row-name">食谱管理</view></view>
        <view class="arrow"></view>
      </view>

      <!-- 通知公告管理入口（仅管理员可见） -->
      <view class="row" wx:if="{{isAdmin}}" bindtap="onNoticeAdminTap">
        <view class="row-ico" style="background:linear-gradient(135deg,#4C8BFF,#2E6BFF)">知</view>
        <view class="row-main"><view class="row-name">通知公告管理</view></view>
        <view class="arrow"></view>
      </view>

      <!-- 相册管理入口（仅管理员可见） -->
      <view class="row" wx:if="{{isAdmin}}" bindtap="onAlbumAdminTap">
        <view class="row-ico" style="background:linear-gradient(135deg,#9B8CFF,#6A5BEF)">册</view>
        <view class="row-main"><view class="row-name">相册管理</view></view>
        <view class="arrow"></view>
      </view>
      <view class="row">
        <view class="row-main">
          <view class="row-name">消息通知</view>
          <view class="row-sub">接收课表、活动与请假审批提醒</view>
        </view>
        <switch checked="{{noticeOn}}" color="#2E6BFF" bindchange="onSwitchChange" />
      </view>
      <view class="row" bindtap="onMoreTap">
        <view class="row-main">
          <view class="row-name">清除缓存</view>
        </view>
        <view class="row-val gray">{{cacheSize}}</view>
        <view class="arrow"></view>
      </view>
      <view class="row" bindtap="onMoreTap">
        <view class="row-main">
          <view class="row-name">关于我们</view>
        </view>
        <view class="row-val gray">{{version}}</view>
        <view class="arrow"></view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-box">
      <view class="btn-primary" bindtap="onLogout">退出登录</view>
    </view>
    <view class="foot-tip" bindlongpress="onOpenIdLongPress">阳光幼儿园 · 家长端 {{version}}</view>
  </view>
</view>
