/* pages/album/album.wxss —— 班级相册（家长端）（通用 class 见 app.wxss） */

/* 底部有导航栏：为它预留高度 */
.page {
  padding-bottom: 220rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部头图（校园主题绿，和「校园」页一脉） ---------- */
.hd-album {
  background: linear-gradient(135deg, #3FC5A0, #12A182);
}

.hd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

/* 标题已在 .hd-row 内，去掉 app.wxss 里的上间距 */
.hd-album .hd-title {
  padding-top: 0;
  font-size: 38rpx;
}

.hd-back {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hd-back-hover {
  opacity: 0.7;
}

/* 右上占位：仅为保持标题居中 */
.hd-back.ghost {
  visibility: hidden;
}

/* 返回箭头（两条边框拼出的左尖括号，纯 CSS 无图片） */
.ico-back {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(45deg);
}

/* ---------- 班级选择 ---------- */
.pills {
  display: flex;
  flex-wrap: wrap;
}

.pill {
  margin: 6rpx 12rpx 6rpx 0;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #5A6273;
  background: #F1F4FA;
}

.pill.on {
  color: #FFFFFF;
  font-weight: 600;
  background: #12A182;
  box-shadow: 0 8rpx 16rpx rgba(18, 161, 130, 0.24);
}

.cls-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #A6AEBE;
}

/* ---------- 相册卡片行 ---------- */
.al-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid #F0F2F7;
}

.al-cover {
  flex-shrink: 0;
  width: 160rpx;
  height: 120rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.al-img {
  width: 100%;
  height: 100%;
}

/* 没有真照片时：渐变底 + 相册名前 4 个字 */
.al-word {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.al-main {
  flex: 1;
  min-width: 0;
}

.al-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1B1F27;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.al-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A93A3;
}

.al-tag {
  margin-top: 12rpx;
}

/* ---------- 照片网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.cell {
  position: relative;
  width: 31.5%;
  height: 200rpx;
  margin-bottom: 16rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.cell-img {
  width: 100%;
  height: 100%;
}

/* 占位方块：浅灰底 + 照片名（本项目不带图片资源） */
.cell-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EEF1F7;
  color: #A6AEBE;
  font-size: 22rpx;
}

/* ---------- 其它 ---------- */
.more-btn {
  margin: 20rpx auto 0;
  padding: 18rpx 0;
  width: 360rpx;
  text-align: center;
  border-radius: 999rpx;
  border: 2rpx solid #DCE3EF;
  font-size: 25rpx;
  color: #5A6273;
}

.grid-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 21rpx;
  color: #A6AEBE;
}

.row-hint {
  padding-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A6AEBE;
}

.foot-note {
  margin: 24rpx 8rpx 40rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #A6AEBE;
}
